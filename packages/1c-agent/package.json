{
	"name": "@earendil-works/pi-1c-agent",
	"version": "0.1.10",
	"description": "1C AI agent extension: EDT metadata tools, infobase build, BSL LSP feedback, Deep Code Navigator, ITS Auto-Fixer and Modes",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"keywords": [
		"pi-package",
		"1c",
		"bsl",
		"v8std",
		"edt",
		"lsp"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"bin": {
		"perun": "./bin/perun"
	},
	"scripts": {
		"build": "node ../../scripts/build-perun.mjs",
		"start": "./bin/perun",
		"start:bundle": "node ./bin/perun.bundle.mjs",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^1.1.0",
		"@earendil-works/pi-ai": "^1.1.0",
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@earendil-works/pi-tui": "^1.1.0",
		"fast-xml-parser": "5.11.2",
		"fast-xml-validator": "1.4.2",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}
